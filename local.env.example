# The local paths of this machine. Copy this file to local.env (git ignores it) and fill it in.
# One KEY=value per line, the value as is: no escaping, spaces kept, quotes around it dropped.
# An environment variable of the same name overrides a line here. Read by Kichikuou.Engine.LocalPaths
# (the tests, the Godot game's default folders) and tools/golden/capture.ps1; the agent reads it
# for the commands in CLAUDE.md and the docs. docs/spike-findings.md, "Local layout", says what
# each folder holds.

# The game: the English release (System39.exe, the .ALD archives, bgm\, _inmm.ini).
KICHIKUOU_GAME_DIR=
# The extracted data, "_extract" in the docs: scenario\, scenario_named\, cg_pms\, cg_png\, wav\,
# aindump\, golden\ (the captures).
KICHIKUOU_EXTRACT_DIR=
# Optional: one subfolder of the extract somewhere else.
#KICHIKUOU_SCENARIO_DIR=
#KICHIKUOU_GOLDEN_DIR=

# Godot 4.7.2 .NET: the console executable (the editor's is next to it).
KICHIKUOU_GODOT_EXE=
# The Android release key (docs/release.md): its keystore file, outside the repository and backed up, and its alias
# (else "kichikuou"). Never its password: the release scripts ask for it (or read GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD).
#KICHIKUOU_ANDROID_KEYSTORE=
#KICHIKUOU_ANDROID_KEY_ALIAS=
# Optional: the screen gallery's pictures elsewhere than screen-gallery at the root, which git ignores
# (tools/ui/gallery.ps1, docs/ui/gallery.md). Inside the repository only a folder git ignores.
#KICHIKUOU_UI_GALLERY_DIR=
# Optional: a Python with Pillow and numpy for the mock-ups that the gallery draws (gallery.ps1 -Phone); else python.
#KICHIKUOU_PYTHON=
# The xsystem35-sdl2 checkout with the golden harness (branch golden-harness).
KICHIKUOU_XSYSTEM35_DIR=
# MSYS2, the toolchain that builds xsystem35-sdl2.
KICHIKUOU_MSYS2_DIR=
# The alice-tools source checkout, a read-only reference.
KICHIKUOU_ALICE_TOOLS_DIR=

# The released tools of the spike (docs/spike-findings.md).
# xsystem35 2.20.0, Windows build.
KICHIKUOU_XSYSTEM35_RELEASE_DIR=
# xsys35c 1.13.0 (xsys35dc, ald, pms, ...).
KICHIKUOU_XSYS35C_DIR=
# alice-tools 0.13.0, Windows build.
KICHIKUOU_ALICE_TOOLS_RELEASE_DIR=

# Sengoku Rance, a reference for our own battle screen (docs/sengoku/): the MangaGamer release
# (Rance7.ain) and its dump by alice-tools (ain\code.jam, ain\files\ split per source, ain\text.txt).
#SENGOKU_RANCE_GAME_DIR=
#SENGOKU_RANCE_EXTRACT_DIR=
