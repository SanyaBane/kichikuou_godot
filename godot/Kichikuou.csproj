<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Godot 4.7 exports C# to Android on .NET 9 only (docs/backlog.md, "Android"). -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Kichikuou.Game</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Kichikuou.Engine\Kichikuou.Engine.csproj" />
    <ProjectReference Include="..\src\Kichikuou.Content\Kichikuou.Content.csproj" />
    <ProjectReference Include="..\src\Kichikuou.Original\Kichikuou.Original.csproj" />
    <ProjectReference Include="..\src\Kichikuou.Original.Content\Kichikuou.Original.Content.csproj" />
  </ItemGroup>

</Project>
