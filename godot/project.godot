; Engine configuration file.
; Edit through the Godot editor (Project Settings) where possible.

config_version=5

[application]

config/name="Kichikuou"
config/version="0.2"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon/window.png"
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="KichikuouGodot"
config/quit_on_go_back=false
run/flush_stdout_on_print=true

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_height_override=824
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="Kichikuou"
project/solution_directory="../"

[rendering]

rendering_device/staging_buffer/max_size_mb=16
textures/vram_compression/import_etc2_astc=true
